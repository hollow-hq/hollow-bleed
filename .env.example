# Hollow-Phi example environment. Copy to .env and fill in real values.
# NEVER commit a real .env or real credentials.

# Bot token (from the Discord developer portal)
DISCORD_TOKEN=

# Optional service URL used by some cogs
WARP_URL=http://127.0.0.1:4000

# Database (MySQL/MariaDB via asyncmy). All four are required.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Optional pool tuning
DB_POOL_MAX=30
DB_POOL_MIN=2
DB_CONNECT_TIMEOUT=10
